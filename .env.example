# MovieFrd environment variables.
# Copy this file to `.env.local` and fill in real values. `.env.local` is git-ignored.

# Supabase project (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# TMDB API read access token (v4 auth -> "API Read Access Token")
# https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_v4_read_access_token

# Google Gemini API key (optional — enables AI friend recommendations)
# https://aistudio.google.com/app/apikeys
VITE_GEMINI_API_KEY=your_gemini_api_key
